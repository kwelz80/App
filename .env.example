# Required. Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Users must enter this code before any AI tool runs. Leave empty for open access.
ACCESS_CODE=

# Optional. Defaults to claude-opus-5-5. claude-sonnet-5-5 costs half as much.
ANTHROPIC_MODEL=

# Optional. Requests allowed per visitor (by IP) per window. Defaults: 60 per 60 minutes. 0 turns it off.
RATE_LIMIT_REQUESTS=
RATE_LIMIT_WINDOW_MINUTES=

# Optional. Name shown in the header and page titles. Defaults to StudyDesk.
NEXT_PUBLIC_APP_NAME=

# Optional. Upload limit in MB per request. Keep at 4 or less on Vercel (its limit is 4.5 MB).
NEXT_PUBLIC_MAX_UPLOAD_MB=
